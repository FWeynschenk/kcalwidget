<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher preview only; the live widget is built with Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Left today"
        android:textColor="#8A000000"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="412 kcal"
        android:textColor="#1B5E20"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In 1588  ·  Out 2450  ·  Goal 2000"
        android:textColor="#8A000000"
        android:textSize="11sp" />
</LinearLayout>
